# Klipper & Moonraker Docker Environment Configuration

# Persistent serial path of your 3D printer MCU
# Find this using: ls -l /dev/serial/by-id/
PRINTER_DEVICE=/dev/serial/by-id/usb-Klipper_stm32f446xx_default-if00

# Dialout GID on the host (usually 20 or dialout)
# Find this using: getent group dialout
DIALOUT_GID=dialout

# Moonraker HTTP API port exposed on the host
MOONRAKER_PORT=7125

# Camera device path on the host
CAMERA_DEVICE=/dev/video0

# Webcam streaming options
WEBCAM_PORT=8080
WEBCAM_RESOLUTION=1280x720
WEBCAM_FPS=30
WEBCAM_FORMAT=MJPEG

